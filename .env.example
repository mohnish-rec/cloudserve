# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore, so your key is never committed.

# Model provider (free tier): https://console.groq.com/keys
# If Groq is unavailable, tickets are escalated to a person.
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_key_here
MODEL_NAME=openai/gpt-oss-20b
BACKUP_MODEL_NAME=openai/gpt-oss-120b

EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PATH=./storage/chroma
DATABASE_URL=sqlite:///./storage/decisions.db

LOG_LEVEL=INFO
# Chosen in decision D-019 (Setup Guide default 0.80)
CONFIDENCE_THRESHOLD=0.85
RETRIEVAL_TOP_K=5

# Search settings chosen in decision D-017 (leave as they are)
CHUNK_SIZE=400
CHUNK_OVERLAP=80
RETRIEVAL_MODE=hybrid
RETRIEVAL_MIN_SIMILARITY=0.35

# Routing (src/route.py)
# "Draft ready: check and send" needs at least this confidence (just under the threshold, FR-07)
DRAFT_READY_MIN_CONFIDENCE=0.60
# Kill switch (FR-16): create this file to stop all automatic replies at once, delete it to restart them
KILL_SWITCH_FILE=storage/kill_switch

# Guardrails (src/guardrails.py, decision D-020)
# The second grounding check uses a different model family from the reply writer
GUARDRAIL_MODEL=qwen/qwen3.8-27b
# Share of a sentence's words that must appear in the article it cites
WORD_SUPPORT_MIN=0.6

# Reply cache (D-025): the same prompt to the same model is answered once, then reused
REPLY_CACHE=on
CACHE_PATH=storage/cache.db
